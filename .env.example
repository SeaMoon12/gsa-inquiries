# Gemini API Key (Google AI Studio - https://aistudio.google.com/)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Firebase Configuration (Firebase Console -> Project Settings -> General)
FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
FIREBASE_AUTH_DOMAIN=your-gsa-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-gsa-project
FIREBASE_STORAGE_BUCKET=your-gsa-project.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=000000000000
FIREBASE_APP_ID=1:000000000000:web:0000000000000000
FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX
